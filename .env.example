# Firebase web configuration is public client configuration (not a private key).
# Vite exposes VITE_* variables to browser code. Never put secrets here.
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-your-sender-id
VITE_FIREBASE_APP_ID=replace-with-your-app-id
VITE_PUBLIC_MENU_URL=https://your-site.web.app/

# This is a non-secret setting. The trusted backend currently uses a fixed 5% GST.
VITE_TAX_RATE=0.05
VITE_TRUSTED_ORDER_BACKEND_ENABLED=false
VITE_LOCAL_FUNCTIONS_EMULATOR=false
